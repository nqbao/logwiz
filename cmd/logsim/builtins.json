{
  "templates": [
    {"name": "web-get-ok",      "template": "{ip} - - [{ts}] \"GET /api/v1/{choice:users,orders,items,events} HTTP/1.1\" 200 {rand:100-8000}"},
    {"name": "web-get-cached",  "template": "{ip} - - [{ts}] \"GET /static/{choice:app.js,app.css,logo.png,font.woff2} HTTP/1.1\" 304 0"},
    {"name": "web-get-static",  "template": "{ip} - - [{ts}] \"GET /static/{choice:app.js,app.css,logo.png} HTTP/1.1\" 200 {rand:5000-80000}"},
    {"name": "web-post-ok",     "template": "{ip} - - [{ts}] \"POST /api/v1/{choice:users,orders,sessions} HTTP/1.1\" {choice:200,201} {rand:200-1000}"},
    {"name": "web-post-unauth", "template": "{ip} - - [{ts}] \"POST /api/v1/sessions HTTP/1.1\" 401 45"},
    {"name": "web-post-bad",    "template": "{ip} - - [{ts}] \"POST /api/v1/{choice:users,orders} HTTP/1.1\" 400 {rand:50-300}"},
    {"name": "web-notfound",    "template": "{ip} - - [{ts}] \"GET /{choice:admin,wp-login,phpmyadmin,.env} HTTP/1.1\" 404 12"},
    {"name": "web-error",       "template": "{ip} - - [{ts}] \"GET /api/v1/{choice:users,orders} HTTP/1.1\" 500 {rand:100-500}"},
    {"name": "web-healthz",     "template": "127.0.0.1 - - [{ts}] \"GET /healthz HTTP/1.1\" 200 4"},

    {"name": "log-info-complete",  "template": "{ts} INFO  processed batch of {rand:10-200} items in {rand:10-500}ms"},
    {"name": "log-info-retry",     "template": "{ts} INFO  retrying in {rand:1-30}s (attempt {rand:1-5}/5)"},
    {"name": "log-info-connected", "template": "{ts} INFO  connected to {choice:db,cache,queue} at localhost:{rand:5432-6380}"},
    {"name": "log-debug-cache",    "template": "{ts} DEBUG cache {choice:hit,hit,hit,miss} key={rand:1-9999}"},
    {"name": "log-debug-query",    "template": "{ts} DEBUG query took {rand:1-80}ms rows={rand:0-5000}"},
    {"name": "log-warn-queue",     "template": "{ts} WARN  queue depth {rand:80-200} exceeds threshold"},
    {"name": "log-warn-memory",    "template": "{ts} WARN  high memory usage: {rand:75-95}%"},
    {"name": "log-error-conn",     "template": "{ts} ERROR {choice:connection refused,timeout,unexpected EOF,context deadline exceeded}: worker {rand:1-8}"},
    {"name": "log-error-upstream", "template": "{ts} ERROR failed to reach upstream after {rand:2-5} retries"},

    {"name": "json-request",   "template": "{\"time\":\"{ts}\",\"level\":\"info\",\"msg\":\"request\",\"ms\":{rand:1-500},\"status\":{choice:200,200,200,201,204},\"path\":\"/api/v1/{choice:users,orders,items}\"}"},
    {"name": "json-cache",     "template": "{\"time\":\"{ts}\",\"level\":\"debug\",\"msg\":\"cache {choice:hit,hit,miss}\",\"key\":\"{rand:1-9999}\",\"ttl\":{rand:60-3600}}"},
    {"name": "json-slowquery", "template": "{\"time\":\"{ts}\",\"level\":\"warn\",\"msg\":\"slow query\",\"ms\":{rand:200-2000},\"table\":\"{choice:users,orders,events}\"}"},
    {"name": "json-error",     "template": "{\"time\":\"{ts}\",\"level\":\"error\",\"msg\":\"handler failed\",\"error\":\"{choice:timeout,nil pointer dereference,EOF}\",\"path\":\"/api/v1/items/{rand:1-999}\"}"},
    {"name": "json-worker",    "template": "{\"time\":\"{ts}\",\"level\":\"info\",\"msg\":\"worker heartbeat\",\"id\":{rand:1-8},\"queue\":{rand:0-200}}"},

    {"name": "spin-build",    "template": "building... {rand:1-33}%{cr}building... {rand:34-66}%{cr}building... {rand:67-99}%{cr}building... done"},
    {"name": "spin-download", "template": "downloading ({rand:1-50}/{rand:51-100}){cr}downloading ({rand:51-99}/{rand:51-100}){cr}download complete"},
    {"name": "spin-compile",  "template": "compiling {rand:100-300} files...{cr}compiled in {rand:1-9}.{rand:0-9}s"},

    {"name": "crash-startup",   "template": "{ts} INFO  application started, serving on :8080"},
    {"name": "crash-request",   "template": "{ts} DEBUG received {choice:GET,POST,PUT} /{choice:users,orders,items}"},
    {"name": "crash-panic",     "template": "panic: runtime error: {choice:index out of range,nil pointer dereference,interface conversion failed}"},
    {"name": "crash-goroutine", "template": "goroutine {rand:1-20} [running]:"},
    {"name": "crash-frame-fn",  "template": "main.{choice:handler,processItems,run,serve}(...)"},
    {"name": "crash-frame-loc", "template": "\t/app/{choice:main,handler,server}.go:{rand:20-120} +0x{rand:100-999}"},
    {"name": "crash-stdlib",    "template": "net/http.(*ServeMux).ServeHTTP(...)"},
    {"name": "crash-exit",      "template": "exit status 2"},

    {"name": "pyecom-cart-add",        "template": "{ts} DEBUG cart.item_added     user_id={rand:1-5000} sku={choice:SKU-001,SKU-042,SKU-107,SKU-203,SKU-388} qty={rand:1-5} price={rand:5-299}.{rand:10-99}"},
    {"name": "pyecom-inventory-check", "template": "{ts} DEBUG inventory.check     sku={choice:SKU-001,SKU-042,SKU-107,SKU-203,SKU-388} stock={rand:0-500}"},
    {"name": "pyecom-order-created",   "template": "{ts} INFO  order.created       order_id={rand:10000-99999} user_id={rand:1-5000} items={rand:1-8} total={rand:10-499}.{rand:10-99}"},
    {"name": "pyecom-payment-ok",      "template": "{ts} INFO  payment.charged     order_id={rand:10000-99999} provider={choice:stripe,paypal,braintree} amount={rand:10-499}.{rand:10-99} duration_ms={rand:80-600}"},
    {"name": "pyecom-order-fulfilled", "template": "{ts} INFO  order.fulfilled     order_id={rand:10000-99999} warehouse={choice:US-EAST,US-WEST,EU-CENTRAL} items={rand:1-8}"},
    {"name": "pyecom-order-shipped",   "template": "{ts} INFO  shipment.dispatched order_id={rand:10000-99999} carrier={choice:fedex,ups,usps,dhl} tracking={rand:100000000-999999999}"},
    {"name": "pyecom-payment-failed",  "template": "{ts} WARNING payment.failed    order_id={rand:10000-99999} provider={choice:stripe,paypal} reason={choice:insufficient_funds,card_declined,fraud_detected}"},
    {"name": "pyecom-stock-low",       "template": "{ts} WARNING inventory.low     sku={choice:SKU-001,SKU-042,SKU-107} stock={rand:1-10} threshold=20"},
    {"name": "pyecom-exception", "template": "Traceback (most recent call last):{nl}  File \"/app/{choice:orders/views,payments/processor,cart/models,inventory/tasks}.py\", line {rand:20-200}, in {choice:process_order,handle_payment,checkout,reserve_stock}{nl}    {choice:result = gateway.charge(order),order.save(),cart.checkout(),inventory.reserve(sku)}{nl}{choice:stripe.error.CardError,django.db.OperationalError,requests.exceptions.Timeout,KeyError,ValueError}: {choice:Your card was declined.,no such table: orders_orderitem,Read timed out. (connect timeout=5),'product_id',invalid literal for int() with base 10}"},

    {"name": "goweb-req-ok",      "template": "ts=\"{ts}\" level=info msg=request method={choice:GET,GET,GET,POST,PUT} path=/api/v1/{choice:users,orders,items,events} status=200 duration={rand:1-150}ms bytes={rand:100-8000}"},
    {"name": "goweb-req-slow",    "template": "ts=\"{ts}\" level=warn msg=slow_request method=GET path=/api/v1/{choice:users,orders,items} status=200 duration={rand:500-3000}ms bytes={rand:100-8000}"},
    {"name": "goweb-req-error",   "template": "ts=\"{ts}\" level=error msg=handler_failed method={choice:GET,POST} path=/api/v1/{choice:users,orders,items} status=500 error={choice:timeout,db_unavailable,nil_pointer}"},
    {"name": "goweb-req-unauth",  "template": "ts=\"{ts}\" level=warn msg=unauthorized method=POST path=/api/v1/{choice:admin,tokens,users} status=401 ip={ip}"},
    {"name": "goweb-db-query",    "template": "ts=\"{ts}\" level=debug msg=db_query table={choice:users,orders,items,events} duration={rand:1-80}ms rows={rand:0-500}"},
    {"name": "goweb-db-slow",     "template": "ts=\"{ts}\" level=warn msg=slow_query table={choice:users,orders,items} duration={rand:200-2000}ms threshold=100ms rows={rand:0-500}"},
    {"name": "goweb-db-error",    "template": "ts=\"{ts}\" level=error msg=db_error table={choice:users,orders} error={choice:deadlock,conn_reset,too_many_connections} retries={rand:1-5}"},
    {"name": "goweb-cache-hit",   "template": "ts=\"{ts}\" level=debug msg=cache_hit key={choice:user,session,order}:{rand:1-9999} ttl={rand:60-3600}"},
    {"name": "goweb-cache-miss",  "template": "ts=\"{ts}\" level=debug msg=cache_miss key={choice:user,session,order}:{rand:1-9999}"},
    {"name": "goweb-worker-ok",   "template": "ts=\"{ts}\" level=info msg=job_complete worker={rand:1-8} job={choice:email,notify,export,import} duration={rand:50-5000}ms"},
    {"name": "goweb-worker-fail", "template": "ts=\"{ts}\" level=error msg=job_failed worker={rand:1-8} job={choice:email,notify,export} error={choice:timeout,panic_recovered,queue_full} retries={rand:1-5}"},
    {"name": "goweb-gc",          "template": "ts=\"{ts}\" level=debug msg=gc_pause duration={rand:1-30}ms heap_mb={rand:50-512} goroutines={rand:10-200}"}
  ],
  "presets": [
    {
      "name": "web-access",
      "templates": [
        {"name": "web-get-ok",      "weight": 60},
        {"name": "web-get-cached",  "weight": 15},
        {"name": "web-get-static",  "weight": 10},
        {"name": "web-post-ok",     "weight": 7},
        {"name": "web-post-unauth", "weight": 3},
        {"name": "web-post-bad",    "weight": 2},
        {"name": "web-notfound",    "weight": 2},
        {"name": "web-error",       "weight": 0.5},
        {"name": "web-healthz",     "weight": 0.5}
      ]
    },
    {
      "name": "errors",
      "templates": [
        {"name": "log-info-complete",  "weight": 20},
        {"name": "log-info-retry",     "weight": 5},
        {"name": "log-info-connected", "weight": 5},
        {"name": "log-debug-cache",    "weight": 25},
        {"name": "log-debug-query",    "weight": 20},
        {"name": "log-warn-queue",     "weight": 10},
        {"name": "log-warn-memory",    "weight": 5},
        {"name": "log-error-conn",     "weight": 7},
        {"name": "log-error-upstream", "weight": 3}
      ]
    },
    {
      "name": "json",
      "templates": [
        {"name": "json-request",   "weight": 60},
        {"name": "json-cache",     "weight": 20},
        {"name": "json-slowquery", "weight": 10},
        {"name": "json-error",     "weight": 5},
        {"name": "json-worker",    "weight": 5}
      ]
    },
    {
      "name": "spinner",
      "templates": [
        {"name": "spin-build",    "weight": 33},
        {"name": "spin-download", "weight": 33},
        {"name": "spin-compile",  "weight": 34}
      ]
    },
    {
      "name": "crash",
      "templates": [
        {"name": "crash-startup",   "weight": 20},
        {"name": "crash-request",   "weight": 20},
        {"name": "crash-panic",     "weight": 8},
        {"name": "crash-goroutine", "weight": 7},
        {"name": "crash-frame-fn",  "weight": 15},
        {"name": "crash-frame-loc", "weight": 15},
        {"name": "crash-stdlib",    "weight": 10},
        {"name": "crash-exit",      "weight": 5}
      ]
    },
    {
      "name": "pyecom",
      "templates": [
        {"name": "pyecom-cart-add",        "weight": 25},
        {"name": "pyecom-inventory-check", "weight": 20},
        {"name": "pyecom-order-created",   "weight": 15},
        {"name": "pyecom-payment-ok",      "weight": 10},
        {"name": "pyecom-order-fulfilled", "weight": 8},
        {"name": "pyecom-order-shipped",   "weight": 7},
        {"name": "pyecom-payment-failed",  "weight": 4},
        {"name": "pyecom-stock-low",       "weight": 3},
        {"name": "pyecom-exception", "weight": 3}
      ]
    },
    {
      "name": "go-webapp",
      "templates": [
        {"name": "goweb-req-ok",      "weight": 50},
        {"name": "goweb-req-slow",    "weight": 5},
        {"name": "goweb-req-error",   "weight": 3},
        {"name": "goweb-req-unauth",  "weight": 2},
        {"name": "goweb-db-query",    "weight": 20},
        {"name": "goweb-db-slow",     "weight": 4},
        {"name": "goweb-db-error",    "weight": 1},
        {"name": "goweb-cache-hit",   "weight": 8},
        {"name": "goweb-cache-miss",  "weight": 3},
        {"name": "goweb-worker-ok",   "weight": 3},
        {"name": "goweb-worker-fail", "weight": 0.5},
        {"name": "goweb-gc",          "weight": 0.5}
      ]
    },
    {
      "name": "mixed",
      "templates": [
        {"name": "json-request",      "weight": 20},
        {"name": "json-cache",        "weight": 8},
        {"name": "json-slowquery",    "weight": 4},
        {"name": "json-error",        "weight": 2},
        {"name": "goweb-req-ok",      "weight": 20},
        {"name": "goweb-db-query",    "weight": 8},
        {"name": "goweb-req-slow",    "weight": 3},
        {"name": "goweb-req-error",   "weight": 2},
        {"name": "log-info-complete", "weight": 10},
        {"name": "log-debug-cache",   "weight": 8},
        {"name": "log-warn-queue",    "weight": 5},
        {"name": "log-error-conn",    "weight": 3},
        {"name": "crash-panic",       "weight": 1},
        {"name": "crash-goroutine",   "weight": 1}
      ]
    }
  ]
}
